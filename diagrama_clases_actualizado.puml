@startuml TechnoTaller Domain Classes - Actualizado con SOLID

!define ABSTRACT abstract
!define INTERFACE interface

' ============ INTERFACES - DIP (Dependency Inversion Principle) ============

interface IAuthorizationFilter {
    + applyFilter(options: Record): void
}

interface INotifier {
    + send(message: NotificationMessage): Promise<void>
}

interface IWorkOrderRepository {
    + findById(id: string): Promise<WorkOrderRow | null>
    + list(options): Promise<{rows, total}>
    + create(input, guideNumber, status): Promise<WorkOrderRow>
    + transitionStatus(id, from, to, userId): Promise<WorkOrderRow>
}

' ============ CLASES DE ESTRATEGIA - OCP (Open/Closed Principle) ============

class TechnicianAuthorizationFilter {
    + applyFilter(options: Record): void
}

class AdminAuthorizationFilter {
    + applyFilter(options: Record): void
}

class ClientAuthorizationFilter {
    + applyFilter(options: Record): void
}

class AuthorizationFilterFactory {
    + {static} createFilter(role: string): IAuthorizationFilter
}

' ============ CLASES DE MIDDLEWARE - SRP (Single Responsibility Principle) ============

class ValidateRequestMiddleware {
    - schema: ZodSchema
    --
    + handle(req: Request, res: Response, next: NextFunction): Promise<void>
}

' ============ SERVICIOS ============

class WorkOrderService {
    - repository: IWorkOrderRepository
    - guid: GuidGenerator
    --
    + create(input, initialStatus): Promise<WorkOrder>
    + getById(id): Promise<WorkOrder>
    + list(options): Promise<{items, total}>
    + transitionStatus(id, to, userId): Promise<WorkOrder>
    + trackByGuide(guideNumber): Promise<{order, history}>
    + registerExit(id, input): Promise<WorkOrder>
}

class AuthService {
    - repository: IAuthRepository
    --
    + register(input): Promise<AuthUser>
    + login(input): Promise<AuthSession>
    + logout(accessToken): Promise<void>
    + getProfile(userId): Promise<AuthUser>
}

class PurchaseRequestService {
    - repository: IPurchaseRequestRepository
    --
    + create(input, userId): Promise<PurchaseRequest>
    + updateStatus(id, input): Promise<PurchaseRequest>
    + markAsReceived(id): Promise<PurchaseRequest>
}

' ============ CONTROLADORES - SRP (Single Responsibility Principle) ============

class WorkOrderController {
    - service: WorkOrderService
    - activityService: ActivityService
    --
    + create(req: Request, res: Response): void
    + createAsClient(req: Request, res: Response): void
    + list(req: Request, res: Response): void
    + getById(req: Request, res: Response): void
    + transitionStatus(req: Request, res: Response): void
}

class AuthController {
    - service: AuthService
    --
    + register(req: Request, res: Response): void
    + login(req: Request, res: Response): void
    + logout(req: Request, res: Response): void
    + me(req: Request, res: Response): void
}

' ============ CLASES DEL DOMINIO ============

class TechnicalService {
    - id: string
    - name: string
    - description: string
    - price: number
    - _active: boolean
    --
    + activate(): void
    + deactivate(): void
    + get active(): boolean
    + toJSON(): object
}

class Appointment {
    - id: string
    - serviceId: string
    - customerName: string
    - phone: string
    - date: Date
    - _status: AppointmentStatus
    - createdAt: Date
    --
    + confirm(): void
    + cancel(): void
    + complete(): void
    + get status(): AppointmentStatus
    + toJSON(): object
}

class WorkOrder {
    - id: string
    - guideNumber: string
    - customerId: string | null
    - technicianId: string | null
    - deviceBrand: string
    - deviceModel: string
    - deviceSerial: string
    - problemDescription: string
    - accessories: string | null
    - _currentStatus: OrderStatus
    - scheduledTime: string | null
    - assignedTime: string | null
    - createdAt: string
    --
    + canTransitionTo(status): boolean
    + transitionTo(status): void
    + get currentStatus(): OrderStatus
    + toJSON(): object
    + static fromRow(row): WorkOrder
}

class PurchaseRequest {
    - id: string
    - supplierId: string
    - productId: string | null
    - partId: string | null
    - quantity: number
    - unitPrice: number
    - subtotal: number
    - total: number
    - _status: PurchaseStatus
    - createdAt: string
    --
    + markAsReceived(): Promise<void>
    + canReceive(): boolean
    + get status(): PurchaseStatus
    + toJSON(): object
}

class Product {
    - id: string
    - sku: string
    - name: string
    - description: string
    - imageUrl: string | null
    - categoryId: string | null
    - purchasePrice: number
    - salePrice: number
    - _stock: number
    - _active: boolean
    --
    + addStock(quantity): void
    + removeStock(quantity): void
    + activate(): void
    + deactivate(): void
    + get stock(): number
    + get active(): boolean
    + toJSON(): object
}

class Part {
    - id: string
    - name: string
    - sku: string
    - _stock: number
    - purchasePrice: number
    - salePrice: number
    --
    + addStock(quantity): void
    + removeStock(quantity): void
    + get stock(): number
    + toJSON(): object
}

class Customer {
    - id: string
    - email: string | null
    - fullName: string
    - phone: string | null
    - createdAt: string
}

class Technician {
    - id: string
    - fullName: string
    - email: string
    - phone: string | null
    - active: boolean
    - createdAt: string
}

class AuthUser {
    - id: string
    - email: string
    - role: Role
    - fullName: string
    - phone: string | null
}

class Supplier {
    - id: string
    - name: string
    - contactEmail: string | null
    - phone: string | null
    - active: boolean
    - createdAt: string
}

class Diagnostic {
    - id: string
    - workOrderId: string
    - technicianId: string
    - observations: string
    - faults: string
    - recommendedActions: string
    - createdAt: string
}

class Warranty {
    - id: string
    - workOrderId: string
    - periodDays: number
    - expiresAt: string
    - status: WarrantyStatus
    - createdAt: string
}

class InventoryMovement {
    - id: string
    - productId: string | null
    - partId: string | null
    - type: InventoryMovementType
    - quantity: number
    - reason: string
    - userId: string
    - createdAt: string
}

class StatusHistoryEntry {
    - id: string
    - fromStatus: OrderStatus
    - toStatus: OrderStatus
    - userId: string
    - createdAt: string
}

' ============ RELACIONES DE ARQUITECTURA - OCP Y DIP ============

' Relaciones Strategy Pattern (OCP)
IAuthorizationFilter <|.. TechnicianAuthorizationFilter : implements
IAuthorizationFilter <|.. AdminAuthorizationFilter : implements
IAuthorizationFilter <|.. ClientAuthorizationFilter : implements
AuthorizationFilterFactory --> IAuthorizationFilter : creates

' Relación Middleware (SRP)
ValidateRequestMiddleware --> "1" "ZodSchema" : valida

' Relaciones Servicios - Inyección de Dependencias (DIP)
WorkOrderService --> "1" IWorkOrderRepository : depends on
WorkOrderService --> "1" AuthorizationFilterFactory : uses
AuthService --> "1" IAuthRepository : depends on
PurchaseRequestService --> "1" IPurchaseRequestRepository : depends on

' Relaciones Controladores - SRP (Validación en middleware, orquestación en controlador)
WorkOrderController --> "1" WorkOrderService : uses
WorkOrderController --> "1" ActivityService : uses
AuthController --> "1" AuthService : uses

' Relaciones con entidades de dominio
WorkOrderService --> WorkOrder : returns
AuthService --> AuthUser : returns
PurchaseRequestService --> PurchaseRequest : returns

WorkOrder "1" -- "0..1" Customer : "tiene cliente"
WorkOrder "1" -- "0..1" Technician : "asignado a"
Appointment "N" -- "1" TechnicalService : "reserva"
Diagnostic "N" -- "1" Technician : "realizado por"
Warranty "1" -- "1" WorkOrder : "vinculada a"
PurchaseRequest "N" -- "1" Supplier : "de proveedor"
PurchaseRequest "N" -- "1" Product : "compra producto"
PurchaseRequest "N" -- "1" Part : "compra repuesto"

' Agregaciones
WorkOrder "1" o-- "N" Diagnostic : "contiene"
WorkOrder "1" o-- "N" StatusHistoryEntry : "historial"
Customer "1" o-- "N" WorkOrder : "tiene órdenes"
Technician "1" o-- "N" WorkOrder : "realiza"
Product "1" o-- "N" InventoryMovement : "movimientos"
Part "1" o-- "N" InventoryMovement : "movimientos"

' ============ ENUMERACIONES Y TIPOS ============

enum AppointmentStatus {
    PENDIENTE
    CONFIRMADA
    CANCELADA
    COMPLETADA
}

enum OrderStatus {
    INGRESADO
    PENDIENTE
    ACEPTADA
    EN_REVISION
    ESPERANDO_REPUESTO
    EN_REPARACION
    REPARADO
    LISTO_PARA_ENTREGA
    ENTREGADO
}

enum PurchaseStatus {
    PENDIENTE
    ORDENADO
    RECIBIDO
    CANCELADO
}

enum WarrantyStatus {
    VIGENTE
    VENCIDA
}

enum Role {
    CLIENTE
    TECNICO
    ADMINISTRADOR
}

enum InventoryMovementType {
    IN
    OUT
}

' ============ NOTAS Y DIFERENCIAS CON VERSIÓN ANTERIOR ============

note right of IAuthorizationFilter
    **PATRÓN OCP**: Strategy Pattern
    Cada rol es una estrategia intercambiable
    NewStates WorkOrderService NO SE MODIFICA
    al agregar nuevos roles
end note

note right of ValidateRequestMiddleware
    **PATRÓN SRP**: Validación en Middleware
    Controladores NO validan datos
    Solo orquestan respuestas HTTP
    Reutilizable en todas las rutas
end note

note right of AuthController
    **REFACTORIZADO**:
    - Ya NO hace registerSchema.parse()
    - Recibe datos en req.validatedData
    - SRP: Solo orquestación HTTP
end note

note right of WorkOrderService
    **REFACTORIZADO**:
    - Ya NO tiene if (userRole === 'tecnico')
    - Usa AuthorizationFilterFactory
    - OCP: Cerrado a modificación
end note

note right of PurchaseRequest
    **NUEVO**: Incluye validación XOR
    - Validar que productId XOR partId
    - NO ambos, NO ninguno
    - markAsReceived() es transaccional
    - Idempotente: rechazo si ya está RECIBIDO
end note

note bottom of Supplier
    **NUEVO MÓDULO**: Para purchase-requests
    Proveedor de productos y repuestos
end note

note bottom
    ▲ DIFERENCIAS CON DIAGRAMA ANTERIOR:
    1. Agregadas interfaces IAuthorizationFilter (OCP)
    2. Agregadas clases Strategy: TechnicianAuthorizationFilter, AdminAuthorizationFilter, ClientAuthorizationFilter
    3. Agregada AuthorizationFilterFactory (Factory Pattern)
    4. Agregada ValidateRequestMiddleware (SRP)
    5. Controladores refactorizados (ya no validan con Zod)
    6. Servicios refactorizados (usan factory para autorización)
    7. Nuevo estado PENDIENTE/ACEPTADA en WorkOrder
    8. Nuevos campos: scheduledTime, assignedTime en WorkOrder
    9. Nueva clase PurchaseRequest con lógica transaccional
    10. Nueva clase Supplier
    11. Nuevo enum PurchaseStatus
    12. Agregadas dependencias explícitas (DIP)
end note

@enduml
