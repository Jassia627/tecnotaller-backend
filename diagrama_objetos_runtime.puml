@startuml TechnoTaller Diagrama de Objetos Completo

title Diagrama de Objetos: Instancias del Sistema TecnoTaller Backend

' ============ OBJETOS DE CONFIGURACIÓN ============

object "authFilterFactory: AuthorizationFilterFactory" as authFactory {
    role = "cliente"
}

object "technicianFilter: TechnicianAuthorizationFilter" as techFilter {
    applyFilter() = {auto-asigna technicianId}
}

object "adminFilter: AdminAuthorizationFilter" as adminFilter {
    applyFilter() = {sin restricciones}
}

object "clientFilter: ClientAuthorizationFilter" as clientFilter {
    applyFilter() = {filtra por customerId}
}

object "validatorMiddleware: ValidateRequestMiddleware" as validator {
    schema = "registerSchema, loginSchema, etc"
}

' ============ SERVICIOS ============

object "workOrderService: WorkOrderService" as woService {
    repository = workOrderRepo
    guid = guidGenerator
}

object "authService: AuthService" as authService {
    repository = authRepo
}

object "purchaseService: PurchaseRequestService" as purchaseService {
    repository = purchaseRepo
}

object "activityService: ActivityService" as activityService {
    repository = activityRepo
}

' ============ REPOSITORIOS ============

object "workOrderRepo: WorkOrderRepository" as workOrderRepo {
    supabase = supabaseClient
}

object "authRepo: AuthRepository" as authRepo {
    supabase = supabaseClient
}

object "purchaseRepo: PurchaseRequestRepository" as purchaseRepo {
    supabase = supabaseClient
}

object "activityRepo: ActivityRepository" as activityRepo {
    supabase = supabaseClient
}

' ============ CONTROLADORES ============

object "workOrderController: WorkOrderController" as woController {
    service = woService
    activityService = activityService
}

object "authController: AuthController" as authController {
    service = authService
}

