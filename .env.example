# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# ============================================================================
# Proveedor de datos para clientes
# ============================================================================
# Valores posibles:
#   - supabase (default): usa Supabase Cloud - NO requiere configuración adicional
#   - postgres: usa PostgreSQL directo (Amazon RDS) - requiere configurar RDS_*
#
# En entorno local, dejar en 'supabase' o no definir la variable.
# En entorno AWS, configurar como 'postgres' y llenar las variables RDS_*.
# ============================================================================
# DATA_PROVIDER=supabase

# ============================================================================
# Amazon RDS (solo requerido cuando DATA_PROVIDER=postgres)
# ============================================================================
# RDS_HOST=tu-instancia.xxx.us-east-1.rds.amazonaws.com
# RDS_PORT=5432
# RDS_DATABASE=tecnotaller
# RDS_USER=postgres
# RDS_PASSWORD=tu_password_seguro
# RDS_SSL=true
#
# Ruta al bundle de certificados CA de Amazon RDS (requerido en producción).
# Descargar desde: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# En EC2, colocar en /etc/ssl/certs/rds-ca-bundle.pem
# RDS_CA_BUNDLE_PATH=/etc/ssl/certs/rds-ca-bundle.pem
