@startuml diagrama_state_ANTES
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classFontName Arial

title Diagrama de Clases - Manejo de Estados SIN Patrón State\n(Uso de diccionario y condicionales)

' ============================================================================
' CONSTANTES Y TIPOS
' ============================================================================
class "<<constant>>\nSTATUS_TRANSITIONS" as StatusTransitions {
    PENDIENTE: ['ACEPTADA']
    ACEPTADA: ['EN_REVISION']
    EN_REVISION: ['ESPERANDO_REPUESTO', 'EN_REPARACION']
    ESPERANDO_REPUESTO: ['EN_REPARACION']
    EN_REPARACION: ['REPARADO']
    REPARADO: ['LISTO_PARA_ENTREGA']
    LISTO_PARA_ENTREGA: ['ENTREGADO']
    ENTREGADO: []
}

note right of StatusTransitions
  **PROBLEMA:**
  Las transiciones se definen
  en un diccionario estático.
  
  No hay forma de agregar
  comportamiento específico
  por estado.
end note

' ============================================================================
' TIPO DE ESTADO
' ============================================================================
enum OrderStatus {
    PENDIENTE
    ACEPTADA
    EN_REVISION
    ESPERANDO_REPUESTO
    EN_REPARACION
    REPARADO
    LISTO_PARA_ENTREGA
    ENTREGADO
}

' ============================================================================
' CLASE WORKORDER (CONTEXTO)
' ============================================================================
class WorkOrder {
    -id: string
    -guideNumber: string
    -customerId: string
    -technicianId: string
    -deviceBrand: string
    -deviceModel: string
    **-_currentStatus: OrderStatus**
    --
    +get currentStatus(): OrderStatus
    **+canTransitionTo(next: OrderStatus): boolean**
    **+transitionTo(next: OrderStatus): void**
    +clone(): WorkOrder
    +toJSON(): object
}

note left of WorkOrder
  **PROBLEMA:**
  La clase WorkOrder tiene
  la responsabilidad de:
  
  1. Almacenar datos de la orden
  2. Validar transiciones
  3. Ejecutar transiciones
  
  Esto viola SRP y hace que
  agregar lógica por estado
  requiera modificar esta clase.
end note

' ============================================================================
' CÓDIGO PROBLEMÁTICO
' ============================================================================
note bottom of WorkOrder
  **Código ANTES (con diccionario):**
  
  ```typescript
  canTransitionTo(next: OrderStatus): boolean {
    // Usa diccionario externo
    return STATUS_TRANSITIONS[this._currentStatus].includes(next);
  }
  
  transitionTo(next: OrderStatus): void {
    if (!this.canTransitionTo(next)) {
      throw new Error(`Transición inválida`);
    }
    this._currentStatus = next;
    // No hay forma de ejecutar lógica
    // específica por estado aquí
  }
  ```
  
  **Limitaciones:**
  - No se puede ejecutar lógica al entrar/salir de estados
  - No se pueden agregar reglas por estado
  - Para agregar comportamiento hay que usar if/switch
end note

' ============================================================================
' RELACIONES
' ============================================================================
WorkOrder --> OrderStatus : "usa"
WorkOrder ..> StatusTransitions : "consulta"

' ============================================================================
' SERVICIO
' ============================================================================
class WorkOrderService {
    -repository: IWorkOrderRepository
    --
    +transitionStatus(id, to, userId): WorkOrder
}

note right of WorkOrderService
  El servicio delega la validación
  a WorkOrder.canTransitionTo()
  que usa el diccionario.
  
  Si necesitara lógica específica
  por estado tendría que usar
  switch/if aquí.
end note

WorkOrderService --> WorkOrder : "usa"

@enduml
