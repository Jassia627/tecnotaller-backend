@startuml diagrama_casos_uso_tecnotaller
!define ACTOR_STYLE actor
!define USECASE_STYLE usecase
!define SYSTEM_STYLE rect

skinparam style strictuml
skinparam backgroundColor #FEFEFE
skinparam actor {
    backgroundColor #FFE5CC
    borderColor #000000
}
skinparam usecase {
    backgroundColor #CCE5FF
    borderColor #000000
}
skinparam package {
    backgroundColor #E8F4F8
    borderColor #000000
}

left to right direction

actor "Cliente" as cliente
actor "Técnico" as tecnico
actor "Administrador" as admin
actor "Sistema\n(Notificaciones)" as sistema

rectangle "TechnoTaller - Sistema de Gestión de Taller" {
    package "Gestión de Órdenes de Trabajo" {
        usecase "UC1: Crear Orden de Trabajo" as uc1
        usecase "UC2: Asignar Técnico" as uc2
        usecase "UC3: Actualizar Estado OT" as uc3
        usecase "UC4: Generar Reportes" as uc4
    }

    package "Gestión de Citas" {
        usecase "UC5: Agendar Cita" as uc5
        usecase "UC6: Confirmar Cita" as uc6
        usecase "UC7: Cancelar Cita" as uc7
    }

    package "Gestión de Inventario" {
        usecase "UC8: Registrar Producto" as uc8
        usecase "UC9: Registrar Pieza" as uc9
        usecase "UC10: Actualizar Stock" as uc10
        usecase "UC11: Generar Movimientos" as uc11
    }

    package "Gestión de Técnicos" {
        usecase "UC12: Registrar Técnico" as uc12
        usecase "UC13: Listar Técnicos Disponibles" as uc13
        usecase "UC14: Asignar Carga Laboral" as uc14
    }

    package "Gestión de Clientes" {
        usecase "UC15: Registrar Cliente" as uc15
        usecase "UC16: Ver Historial de Órdenes" as uc16
        usecase "UC17: Gestionar Garantías" as uc17
    }

    package "Sistema Transversal" {
        usecase "UC18: Registrar Auditoría" as uc18
        usecase "UC19: Enviar Notificaciones" as uc19
        usecase "UC20: Autenticación y Autorización" as uc20
    }
}

' Relaciones: Cliente
cliente --> uc5 : "Agrega"
cliente --> uc6 : "Confirma"
cliente --> uc7 : "Cancela"
cliente --> uc15 : "Se registra"
cliente --> uc16 : "Consulta"
cliente --> uc17 : "Consulta"

' Relaciones: Técnico
tecnico --> uc2 : "Recibe asignación"
tecnico --> uc3 : "Actualiza"
tecnico --> uc14 : "Está asignado"
tecnico --> uc16 : "Consulta"

' Relaciones: Administrador
admin --> uc1 : "Crea"
admin --> uc2 : "Asigna"
admin --> uc3 : "Supervisa"
admin --> uc4 : "Genera"
admin --> uc8 : "Registra"
admin --> uc9 : "Registra"
admin --> uc10 : "Actualiza"
admin --> uc12 : "Registra"
admin --> uc13 : "Consulta"
admin --> uc14 : "Asigna"
admin --> uc15 : "Puede crear"
admin --> uc20 : "Gestiona"

' Relaciones: Sistema
sistema --> uc19 : "Genera"

' Inclusiones (include) - Casos que siempre se ejecutan
uc1 ..|> uc20 : <<include>>
uc5 ..|> uc20 : <<include>>
uc3 ..|> uc18 : <<include>>
uc2 ..|> uc18 : <<include>>
uc10 ..|> uc11 : <<include>>
uc10 ..|> uc18 : <<include>>
uc15 ..|> uc20 : <<include>>

' Extensiones (extend) - Casos opcionales
uc3 ..|> uc19 : <<extend>>
uc6 ..|> uc19 : <<extend>>
uc7 ..|> uc19 : <<extend>>

' Generalizaciones (herencia de actores)
tecnico --|> admin : "es especialización de"

note right of uc1
  Creación de nueva OT
  con diagnóstico inicial
end note

note right of uc3
  Transición de estados:
  INGRESADO → EN_PROGRESO
  → DIAGNOSTICADO → ...
  → ENTREGADO
end note

note right of uc5
  Validar disponibilidad
  del técnico asignado
end note

note right of uc19
  SMS, Email, Push
  notificaciones
end note

@enduml
