@startuml C4_Components_WorkOrders
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title TechnoTaller - Modulo Work Orders (C4 - Nivel 3: Componentes)

Person(admin, "Administrador", "Crea y gestiona ordenes")
Person(tecnico, "Tecnico", "Ejecuta y actualiza ordenes")

System_Boundary(work_orders_api, "REST API - Work Orders") {
    
    Component(controller, "WorkOrder Controller", "Express Handler", "Maneja requests HTTP\nValida entrada\nFormatea respuestas")
    
    Component(service, "WorkOrder Service", "Logica de Negocio", "Orquesta operaciones\nImplementa reglas de negocio\nManeja transiciones")
    
    Component(state_machine, "State Machine", "State Pattern", "Valida transiciones\nINGRESADO -> ENTREGADO")
    
    Component(validator, "Validator", "Data Validation", "Valida datos de entrada\nRestricciones de negocio")
    
    Component(repository, "WorkOrder Repository", "Patron Repository", "Implementa CRUD")
    
    Component(mapper, "Entity Mapper", "Factory Pattern", "Convierte BD a Dominio")
    
    Component(audit_service, "Audit Service", "Observer Pattern", "Registra cambios\nTrazabilidad")
    
    Component(notifier, "Notifier Service", "Strategy Pattern", "Interfaz INotifier\nEmail, SMS, Push")
    
    Component(auth_middleware, "Auth Middleware", "JWT Validation", "Valida tokens\nVerifica permisos")
    
    Component(logger, "Logger", "Winston/Pino", "Registra eventos")
    
    Component(error_handler, "Error Handler", "Middleware", "Manejo centralizado")
    
    Component(database, "PostgreSQL", "Supabase BD", "Almacena ordenes")
    
    Component(email_client, "Email Client", "SendGrid", "Notificaciones email")
    
    Component(sms_client, "SMS Client", "Twilio", "Notificaciones SMS")
    
    Component(push_client, "Push Client", "Firebase", "Notificaciones push")
    
    Component(storage_client, "Storage Client", "Supabase Storage", "Fotos reparacion")
}

' RELACIONES - Actor a Controller
Rel(admin, controller, "POST/GET/PATCH")
Rel(tecnico, controller, "GET/PATCH")

' RELACIONES - Controller a Service
Rel(controller, service, "createWorkOrder()")
Rel(controller, service, "getWorkOrder()")
Rel(controller, service, "updateStatus()")
Rel(controller, service, "addPhoto()")

' RELACIONES - Service a Componentes
Rel(service, validator, "Valida")
Rel(service, state_machine, "Transiciones")
Rel(service, repository, "Persiste")
Rel(service, audit_service, "Audita")
Rel(service, notifier, "Notifica")
Rel(service, auth_middleware, "Auth")
Rel(service, logger, "Log")

' RELACIONES - State Machine
Rel(state_machine, validator, "Reglas")

' RELACIONES - Repository
Rel(repository, mapper, "Mapea")
Rel(repository, database, "SQL")
Rel(mapper, database, "I/O")

' RELACIONES - Notifier a Externos
Rel(notifier, email_client, "Email")
Rel(notifier, sms_client, "SMS")
Rel(notifier, push_client, "Push")

' RELACIONES - Storage
Rel(service, storage_client, "Photos")

' RELACIONES - Error Handling
Rel(controller, error_handler, "Errores")

@enduml
